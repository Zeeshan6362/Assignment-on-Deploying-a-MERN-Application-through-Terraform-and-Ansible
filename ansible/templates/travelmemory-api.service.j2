[Unit]
Description=TravelMemory Express API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory={{ travelmemory_app_root }}/backend
EnvironmentFile=/etc/travelmemory/backend.env
ExecStart=/usr/bin/node {{ travelmemory_app_root }}/backend/index.js
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ travelmemory_upload_dir }}

[Install]
WantedBy=multi-user.target
