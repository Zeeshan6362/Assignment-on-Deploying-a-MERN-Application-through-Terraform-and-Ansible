NODE_ENV=production
PORT={{ travelmemory_api_port }}
MONGO_URI=mongodb://{{ mongodb_app_user | urlencode }}:{{ mongodb_app_password | urlencode }}@{{ hostvars[groups['database'][0]].database_private_ip }}:27017/{{ travelmemory_database_name }}?authSource={{ travelmemory_database_name }}
CORS_ORIGIN=http://{{ travelmemory_public_dns }}
UPLOAD_DIR={{ travelmemory_upload_dir }}
MAX_UPLOAD_MB=5
TRUST_PROXY=0
